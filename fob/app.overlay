/*
 * Fob wiring on the carte_uwb support board, fob variant (board README "Révision C"). The UWB
 * side is the same as the car unit's, and the ADXL362 takes the car's CAN side through J1.
 * This pinout follows the board, so it must not change without a board revision:
 *   D0 DW3000 SCK     D1 DW3000 RSTn    D2 DW3000 WAKEUP   D3 DW3000 MOSI
 *   D4 DW3000 MISO    D5 DW3000 CS      D6 DW3000 IRQ
 *   D8 ADXL362 CS     D9 ADXL362 INT1 (wakes the nRF52840 from System OFF)
 *   D17/D18/D19 ADXL362 SCLK/MISO/MOSI (bottom pads, J1 pins 8/6/4)
 *   D7, D10, D14: free (P-MOS, relay and wake input are not fitted on the fob)
 * The bottom pads aren't on the xiao_d connector, so they are named by their nRF52840 pin.
 *
 * The ADXL362 node is only used for its SPI and INT1 specs: CONFIG_SENSOR stays off, so the
 * Zephyr ADXL362 driver isn't built and motion.c drives the registers itself.
 */

/* D6 carries the UWB IRQ: the console is the USB serial port, not this UART. */
&uart0 {
	status = "disabled";
};

/* D4/D5 carry the UWB MISO and CS instead of I2C. */
&i2c1 {
	status = "disabled";
};

/* ADXL362 on the bottom pads D17-D19; CS and INT1 on D8/D9, the board's J1 side. */
&xiao_spi {
	status = "okay";
	pinctrl-0 = <&spi2_adxl_default>;
	pinctrl-1 = <&spi2_adxl_sleep>;
	cs-gpios = <&xiao_d 8 GPIO_ACTIVE_LOW>;

	adxl362: adxl362@0 {
		compatible = "adi,adxl362";
		reg = <0>;
		spi-max-frequency = <1000000>;
		int1-gpios = <&xiao_d 9 GPIO_ACTIVE_HIGH>;
	};
};

/* The DW3000 has its own bus, as on the car unit. */
&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi3_uwb_default>;
	pinctrl-1 = <&spi3_uwb_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&xiao_d 5 GPIO_ACTIVE_LOW>;

	/* No driver yet (Qorvo SDK, as in BLEUWB): the node only records the wiring. */
	dw3000: dw3000@0 {
		compatible = "qorvo,dw3000";
		reg = <0>;
		/* Up to 38 MHz per the datasheet, 32 MHz on SPIM3; start slow and raise it once ranging works. */
		spi-max-frequency = <8000000>;
		/* Active high, the only polarity that works in SLEEP/DEEPSLEEP. */
		irq-gpios = <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		/* Pull low to reset, then release: never drive it high. */
		reset-gpios = <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
		wakeup-gpios = <&xiao_d 2 GPIO_ACTIVE_HIGH>;
		status = "disabled";
	};
};

&pinctrl {
	spi2_adxl_default: spi2_adxl_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 3)>,
				<NRF_PSEL(SPIM_MISO, 1, 5)>,
				<NRF_PSEL(SPIM_MOSI, 1, 7)>;
		};
	};

	spi2_adxl_sleep: spi2_adxl_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 3)>,
				<NRF_PSEL(SPIM_MISO, 1, 5)>,
				<NRF_PSEL(SPIM_MOSI, 1, 7)>;
			low-power-enable;
		};
	};

	spi3_uwb_default: spi3_uwb_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 2)>,
				<NRF_PSEL(SPIM_MOSI, 0, 29)>,
				<NRF_PSEL(SPIM_MISO, 0, 4)>;
		};
	};

	spi3_uwb_sleep: spi3_uwb_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 2)>,
				<NRF_PSEL(SPIM_MOSI, 0, 29)>,
				<NRF_PSEL(SPIM_MISO, 0, 4)>;
			low-power-enable;
		};
	};
};

/*
 * Onboard LiPo charger (Seeed XIAO nRF52840 schematic, not in the Zephyr board files):
 *   P0.17 BQ25101 CHG, low while charging
 *   P0.14 low switches on the 1M/510k divider from BAT+ to P0.31 (AIN7)
 */
/ {
	zephyr,user {
		chg-gpios = <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		vbat-en-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		io-channels = <&adc 7>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};
